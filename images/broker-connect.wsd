@startuml

skinparam componentStyle uml2

file "ConnectBroker(brokerConnectionSettings, brokerId, observer)" as ConnectPackage
file "StoreBrokerInDictionary()" as Dictionary
file "Broker list" as BrokerList
file "BrokersChanged(broker list)" as Notify

frame SiloHost {
}

frame "MqttBroker" as MqttBroker {
}

frame "MqttBroker 2" as MqttBroker2 {
}

frame "MqttBroker n" as MqttBrokerN {
}

MqttBroker --> ConnectPackage
ConnectPackage --> SiloHost
SiloHost --> Dictionary
SiloHost --> BrokerList
BrokerList --> MqttBroker
SiloHost --> Notify
Notify --> MqttBroker2
Notify --> MqttBrokerN

@enduml