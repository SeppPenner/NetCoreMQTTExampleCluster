@startuml

skinparam componentStyle uml2

file "DisconnectBroker(brokerId)" as DisconnectPackage
file "RemoveBrokerFromDictionary()" as Dictionary
file "BrokersChanged(broker list)" as Notify

frame SiloHost {
}

frame "MqttBroker" as MqttBroker {
}

frame "MqttBroker 2" as MqttBroker2 {
}

frame "MqttBroker n" as MqttBrokerN {
}

MqttBroker --> DisconnectPackage
DisconnectPackage --> SiloHost
SiloHost --> Dictionary
SiloHost --> Notify
Notify --> MqttBroker2
Notify --> MqttBrokerN

@enduml